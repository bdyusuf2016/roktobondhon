{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with role-based access control and contact preferences.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": {
          "type": "string",
          "enum": ["super_admin", "admin", "moderator", "volunteer", "donor", "recipient"]
        },
        "organizationId": { "type": "string" },
        "branchId": { "type": "string" },
        "photoUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "fullName", "role"]
    },
    "Donor": {
      "title": "Donor",
      "description": "Blood donor database entity with privacy settings, eligibility, and verification details.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "donorId": { "type": "string" },
        "fullName": { "type": "string" },
        "photoUrl": { "type": "string" },
        "bloodGroup": {
          "type": "string",
          "enum": ["A+", "A-", "B+", "B-", "AB+", "AB-", "O+", "O-"]
        },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "dateOfBirth": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "division": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "union": { "type": "string" },
        "area": { "type": "string" },
        "availability": { "type": "boolean" },
        "emergencyAvailable": { "type": "boolean" },
        "lastDonationDate": { "type": "string" },
        "firstDonationDate": { "type": "string" },
        "totalDonations": { "type": "number" },
        "verificationStatus": {
          "type": "string",
          "enum": ["unverified", "pending", "verified", "rejected", "suspended"]
        },
        "verifiedBy": { "type": "string" },
        "verifiedAt": { "type": "string" },
        "organizationId": { "type": "string" },
        "branchId": { "type": "string" },
        "privacy": {
          "type": "object",
          "properties": {
            "showPhone": { "type": "boolean" },
            "showGender": { "type": "boolean" },
            "showAge": { "type": "boolean" },
            "allowDirectContact": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "donorId", "fullName", "bloodGroup", "district", "upazila"]
    },
    "BloodRequest": {
      "title": "BloodRequest",
      "description": "Patient blood request record with urgency level and tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requestId": { "type": "string" },
        "userId": { "type": "string" },
        "patientName": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "requiredUnits": { "type": "number" },
        "requiredDate": { "type": "string" },
        "requiredTime": { "type": "string" },
        "hospital": { "type": "string" },
        "division": { "type": "string" },
        "district": { "type": "string" },
        "upazila": { "type": "string" },
        "area": { "type": "string" },
        "contactPerson": { "type": "string" },
        "contactNumber": { "type": "string" },
        "relationship": { "type": "string" },
        "emergencyLevel": {
          "type": "string",
          "enum": ["LOW", "NORMAL", "URGENT", "CRITICAL"]
        },
        "notes": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "verified", "active", "matched", "fulfilled", "cancelled", "expired"]
        },
        "verification": {
          "type": "object",
          "properties": {
            "isVerified": { "type": "boolean" },
            "verifiedBy": { "type": "string" },
            "verifiedAt": { "type": "string" }
          }
        },
        "createdAt": { "type": "string" },
        "expiresAt": { "type": "string" }
      },
      "required": ["id", "requestId", "patientName", "bloodGroup", "requiredUnits", "hospital", "district", "contactNumber", "emergencyLevel"]
    },
    "DonorRequest": {
      "title": "DonorRequest",
      "description": "Direct contact request or smart match dispatch sent to a specific donor.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bloodRequestId": { "type": "string" },
        "donorId": { "type": "string" },
        "donorUserId": { "type": "string" },
        "requesterUserId": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["pending", "accepted", "maybe", "declined"]
        },
        "declineReason": { "type": "string" },
        "matchScore": { "type": "number" },
        "createdAt": { "type": "string" },
        "respondedAt": { "type": "string" }
      },
      "required": ["id", "bloodRequestId", "donorId", "status"]
    },
    "Donation": {
      "title": "Donation",
      "description": "Verified successful blood donation transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "donorId": { "type": "string" },
        "donorUserId": { "type": "string" },
        "donorName": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "requestId": { "type": "string" },
        "donationDate": { "type": "string" },
        "hospital": { "type": "string" },
        "units": { "type": "number" },
        "donationType": { "type": "string", "enum": ["Whole Blood", "Platelets", "Plasma", "RBC"] },
        "verifiedBy": { "type": "string" },
        "verificationDate": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "donorId", "donationDate", "hospital"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC role assignments"
    },
    "/donors/{donorId}": {
      "schema": "Donor",
      "description": "Donor registry with medical & location metadata and privacy boundaries"
    },
    "/bloodRequests/{requestId}": {
      "schema": "BloodRequest",
      "description": "Patient blood requirements and fulfillment tracking"
    },
    "/donorRequests/{id}": {
      "schema": "DonorRequest",
      "description": "Smart matching notifications sent to individual donors"
    },
    "/donations/{donationId}": {
      "schema": "Donation",
      "description": "Official logged and verified donation events"
    }
  }
}
