rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'super_admin' || 
        request.auth.token.super_admin == true
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        getUserRole() == 'admin' || 
        getUserRole() == 'super_admin' || 
        request.auth.token.admin == true
      );
    }

    function isModerator() {
      return isAuthenticated() && (
        isAdmin() || 
        getUserRole() == 'moderator'
      );
    }

    function isVolunteer() {
      return isAuthenticated() && (
        isModerator() || 
        getUserRole() == 'volunteer'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Central System Configuration: Anyone can read, only Admins can write
    match /systemConfig/{section} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Settings Versions & Audit Trail: Append-only by Admins, read by Admins
    match /settingsVersions/{versionId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // 3. User Profiles & Roles: Privilege escalation strictly forbidden
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && isOwner(userId) && request.resource.data.role in ['donor', 'recipient'];
      allow update: if isSuperAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
    }

    // 4. Donors Public Directory vs Private Records
    match /donors/{donorId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isVolunteer());
      allow delete: if isAdmin();
    }

    match /donor_private/{donorId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || isVolunteer());
      allow create: if isAuthenticated() && isOwner(request.resource.data.userId);
      allow update: if isAuthenticated() && (isOwner(resource.data.userId) || isVolunteer());
      allow delete: if isSuperAdmin();
    }

    // 5. Blood Requests & Matching
    match /blood_requests/{requestId} {
      allow read: if true;
      allow create: if true; // Public or logged-in seeker can create
      allow update: if isVolunteer() || (isAuthenticated() && isOwner(resource.data.userId));
      allow delete: if isAdmin();
    }

    match /donor_requests/{matchId} {
      allow read: if isAuthenticated() && (
        isOwner(resource.data.donorUserId) || 
        isOwner(resource.data.requesterUserId) || 
        isVolunteer()
      );
      allow create: if isAuthenticated() || isVolunteer();
      allow update: if isAuthenticated() && (isOwner(resource.data.donorUserId) || isVolunteer());
      allow delete: if isAdmin();
    }

    // 6. Blood Compatibility Matrix: SuperAdmin only
    match /bloodCompatibility/{groupId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // 7. Hospitals, Branches & Locations
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Finance & Funds
    match /fund_donations/{donationId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /fund_disbursements/{disbId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /payment_methods/{methodId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (isOwner(resource.data.userId) || resource.data.isBroadcast == true);
      allow create: if isVolunteer() || isAdmin();
      allow update: if isAuthenticated() && isOwner(resource.data.userId);
      allow delete: if isAdmin();
    }
  }
}
