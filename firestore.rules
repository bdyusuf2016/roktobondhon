rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // Security Helper Functions
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return hasUserDoc() ? getUserData().role : 'public';
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        getUserRole() == 'super_admin' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && getUserRole() == 'admin');
    }

    function isModerator() {
      return isAdmin() || (isSignedIn() && getUserRole() == 'moderator');
    }

    function isVolunteer() {
      return isModerator() || (isSignedIn() && getUserRole() == 'volunteer');
    }

    function isSameOrg(orgId) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (hasUserDoc() && getUserData().organizationId == orgId)
      );
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // Users Collection: users/{userId}
    // -------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin() || (isVolunteer() && isSameOrg(resource.data.organizationId));
      allow create: if isOwner(userId) &&
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['donor', 'recipient']);
      allow update: if (isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId', 'branchId']))
        || isSuperAdmin()
        || (isAdmin() && isSameOrg(resource.data.organizationId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'organizationId']));
      allow delete: if isSuperAdmin();
    }

    // Admins registry (explicit list of UID documents)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // -------------------------------------------------------------
    // Donor Partitioning: donorPublic & donorPrivate
    // -------------------------------------------------------------
    // donorPublic: Searchable, open for blood matching, no contact numbers or PII
    match /donorPublic/{donorId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'totalDonations', 'organizationId', 'branchId']))
        || isSuperAdmin()
        || (isVolunteer() && isSameOrg(resource.data.organizationId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId']));
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // donorPrivate: Sensitive details (phone, NID, exact address, admin notes)
    // Protected strictly: Accessible only by donor owner or authorized volunteers/admins of the same org
    match /donorPrivate/{donorId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isVolunteer() && isSameOrg(resource.data.organizationId))
      );
      allow create: if isSignedIn() && (
        request.resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isVolunteer() && isSameOrg(request.resource.data.organizationId))
      );
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedBy', 'verifiedAt', 'adminNotes', 'organizationId']))
        || isSuperAdmin()
        || (isVolunteer() && isSameOrg(resource.data.organizationId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId']));
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // Legacy/Composite donors collection for backward compatibility
    match /donors/{donorId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus', 'verifiedBy', 'verifiedAt', 'totalDonations', 'organizationId']))
        || isSuperAdmin()
        || (isVolunteer() && isSameOrg(resource.data.organizationId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId']));
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // -------------------------------------------------------------
    // Blood Requests (Private full patient details)
    // Protected strictly: Accessible ONLY by requester or authorized org staff
    // Anonymous create blocked; userId spoofing blocked
    // -------------------------------------------------------------
    match /bloodRequests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isVolunteer() && isSameOrg(resource.data.organizationId))
      );
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.userId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId', 'organizationId', 'verification', 'createdAt', 'requestId']))
        || isSuperAdmin()
        || (isVolunteer() && isSameOrg(resource.data.organizationId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['organizationId', 'userId']));
      allow delete: if (isSignedIn() && resource.data.userId == request.auth.uid) || isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // -------------------------------------------------------------
    // Blood Request Public Representation (Emergency Public Listing)
    // Contains NO patient phone number, full name, private notes, or exact address
    // Writable ONLY by authorized staff/volunteers or trusted server workflows
    // -------------------------------------------------------------
    match /bloodRequestPublic/{requestId} {
      allow read: if true; // Publicly visible safe emergency representation
      allow create, update: if isSuperAdmin() || (isVolunteer() && isSameOrg(request.resource.data.organizationId));
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // -------------------------------------------------------------
    // Donor Direct Contact Requests
    // -------------------------------------------------------------
    match /donorRequests/{id} {
      allow read: if isSignedIn() && (
        resource.data.donorUserId == request.auth.uid ||
        resource.data.requesterUserId == request.auth.uid ||
        isSuperAdmin() ||
        (isVolunteer() && isSameOrg(resource.data.organizationId))
      );
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        resource.data.donorUserId == request.auth.uid ||
        resource.data.requesterUserId == request.auth.uid ||
        isSuperAdmin() ||
        (isVolunteer() && isSameOrg(resource.data.organizationId))
      );
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // -------------------------------------------------------------
    // Verified Donation History
    // -------------------------------------------------------------
    match /donations/{donationId} {
      allow read: if isSignedIn() && (
        resource.data.donorUserId == request.auth.uid ||
        isSuperAdmin() ||
        (isVolunteer() && isSameOrg(resource.data.organizationId))
      );
      allow create: if isSuperAdmin() || (isVolunteer() && isSameOrg(request.resource.data.organizationId));
      allow update: if isSuperAdmin() || (isVolunteer() && isSameOrg(resource.data.organizationId));
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    // -------------------------------------------------------------
    // Directory & Configuration
    // -------------------------------------------------------------
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if true;
      allow create: if isSignedIn() || isVolunteer();
      allow update, delete: if isSuperAdmin() || (isModerator() && isSameOrg(resource.data.organizationId));
    }

    match /bloodBanks/{bankId} {
      allow read: if true;
      allow write: if isSuperAdmin() || (isModerator() && isSameOrg(resource.data.organizationId));
    }

    // -------------------------------------------------------------
    // Financial & Fund Management
    // -------------------------------------------------------------
    function isValidFundDonationCreate() {
      let data = request.resource.data;
      return (
        data.keys().hasAll(['donorName', 'donorPhone', 'amount', 'paymentMethod', 'transactionId', 'fundCause', 'status', 'createdAt', 'organizationId']) &&
        !data.keys().hasAny(['verifiedBy', 'verifiedAt']) &&
        data.donorName is string && data.donorName.size() > 0 &&
        data.donorPhone is string && data.donorPhone.size() >= 11 &&
        data.amount is number && data.amount >= 10 &&
        data.paymentMethod is string && data.paymentMethod in ['bKash', 'Nagad', 'Rocket', 'Upay', 'Bank'] &&
        data.transactionId is string && data.transactionId.size() >= 4 &&
        data.fundCause is string && data.fundCause.size() > 0 &&
        data.status == 'pending' &&
        data.createdAt is string && data.createdAt.size() > 0 &&
        data.organizationId is string && (
          data.organizationId == 'org-roktobondon' ||
          exists(/databases/$(database)/documents/organizations/$(data.organizationId))
        ) &&
        (!('donorEmail' in data) || data.donorEmail is string) &&
        (!('accountNumber' in data) || data.accountNumber is string) &&
        (!('area' in data) || data.area is string) &&
        (!('message' in data) || data.message is string) &&
        (!('isAnonymous' in data) || data.isAnonymous is bool) &&
        (!('id' in data) || data.id is string) &&
        (!('userId' in data) || data.userId is string)
      );
    }

    match /fundDonations/{id} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isModerator() && isSameOrg(resource.data.organizationId))
      );
      allow create: if isValidFundDonationCreate();
      allow update: if (
        (isSuperAdmin() || (isModerator() && isSameOrg(resource.data.organizationId))) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'amount', 'transactionId', 'paymentMethod', 'donorPhone', 'organizationId', 'createdAt'
        ]) &&
        request.resource.data.status in ['pending', 'verified', 'rejected']
      );
      allow delete: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    match /fundDisbursements/{id} {
      allow read: if true; // Transparency in charity spending
      allow write: if isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId));
    }

    match /paymentMethods/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /donationCauses/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------
    // User Notifications
    // -------------------------------------------------------------
    match /notifications/{notifId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId)));
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isSuperAdmin() || (isAdmin() && isSameOrg(resource.data.organizationId)));
    }

    // -------------------------------------------------------------
    // Audit & Verification Logs (Immutable append-only)
    // -------------------------------------------------------------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Strict immutability
    }

    match /verificationLogs/{logId} {
      allow read: if isVolunteer();
      allow create: if isVolunteer();
      allow update, delete: if false; // Strict immutability
    }

    // System Settings & Config
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
