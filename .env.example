# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="bdyusuf2016.github.io"

# Application Demo Mode
# Set to "false" when connected to Supabase in production.
# Set to "true" for local sandbox preview with instant role switcher.
VITE_DEMO_MODE="true"

# GitHub Pages & Deployment Config
VITE_BASE_PATH="/roktobondhon/"

# Supabase Web Client Configuration
# Get these from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
